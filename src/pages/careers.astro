<SiteLayout title="人才招聘_云巴 Yunba - App、Web、物联网实时通讯云服务" active="company">
	<section class="page-hero">
		<div class="container">
			<h1>人才招聘</h1>
			<p>Careers</p>
		</div>
	</section>

	<div class="container company-layout">
		<CompanySide active="careers" />
		<div class="company-main">
			<div class="jobs-cols">
				<div>
					<h3 style="margin-top:0;">我们能提供的</h3>
					<ul style="padding-left:20px;color:#555;">
						{perks.map((p) => <li>{p}</li>)}
					</ul>
				</div>
				<div>
					<h3 style="margin-top:0;">联系方式</h3>
					<ul class="contact-list">
						<li><span class="ico">✉</span><a href="mailto:hr@yunba.io">hr@yunba.io</a></li>
						<li><span class="ico">✉</span><a href="mailto:suyong@yunba.io">suyong@yunba.io</a></li>
					</ul>
				</div>
			</div>

			<h3>全职工作</h3>
			{fullTime.map((j) => (
				<details class="job">
					<summary>
						<span>{j.title}</span>
						<span style="color:#bbb;font-weight:400;">展开 ▾</span>
					</summary>
					<div class="job-body">
						<h4>岗位职责</h4>
						<ul>
							{j.duty.map((d) => <li>{d}</li>)}
						</ul>
						<h4>任职资格</h4>
						<ul>
							{j.req.map((r) => <li>{r}</li>)}
						</ul>
						{j.note && <p class="note">{j.note}</p>}
					</div>
				</details>
			))}

			<h3>实习工作</h3>
			{interns.map((j) => (
				<details class="job">
					<summary>
						<span>{j.title}</span>
						<span style="color:#bbb;font-weight:400;">展开 ▾</span>
					</summary>
					<div class="job-body">
						<h4>岗位职责</h4>
						<ul>
							{j.duty.map((d) => <li>{d}</li>)}
						</ul>
						<h4>任职资格</h4>
						<ul>
							{j.req.map((r) => <li>{r}</li>)}
						</ul>
						{j.note && <p class="note">{j.note}</p>}
					</div>
				</details>
			))}
		</div>
	</div>
</SiteLayout>
