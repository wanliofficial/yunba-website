---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductHero from '../../components/site/ProductHero.astro';
import SupportedPlatforms from '../../components/site/SupportedPlatforms.astro';
---

<SiteLayout title="实时统计_云巴 Yunba - App、Web、物联网实时通讯云服务" active="products">
	<ProductHero active="analytics" />

	<section class="section">
		<div class="container">
			<div class="section-title">
				<h2>实时目标用户数，实时用户行为数据</h2>
			</div>
			<div style="text-align:center;margin:10px 0 34px;">
				<img src="/site/static/img/feature-3.png" alt="实时统计" style="max-width:820px;" />
			</div>
			<div class="point-list" style="max-width:760px;margin:0 auto;">
				<div class="point"><strong>实时表图</strong>：展示在线用户、使用情况</div>
				<div class="point"><strong>原始数据接口</strong>：自行整合展现数据</div>
			</div>
		</div>
	</section>

	<SupportedPlatforms />
</SiteLayout>
