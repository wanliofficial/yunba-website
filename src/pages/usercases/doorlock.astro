---
import SiteLayout from '../../layouts/SiteLayout.astro';

// 注：原页正文为整幅方案长图，相关图片未留存于归档，此页以文字说明复现
---

<SiteLayout title="智能门锁_用户案例_云巴 Yunba - App、Web、物联网实时通讯云服务" active="usercases">
	<section class="page-hero">
		<div class="container">
			<h1>智能蓝牙门锁方案</h1>
			<p>云巴智能蓝牙门锁一站式解决方案</p>
		</div>
	</section>

	<div class="container article-body">
		<h3 style="margin-top:0;">方案概述</h3>
		<p>
			云巴智能门锁系统由蓝牙密码门锁硬件、手机客户端、门锁管理后台系统三个部分组成。云巴智能门锁可以使用手机 APP
			多锁管理、远程发送管理权限、远程删除授权密码，手机一键打开门锁，手机查询开锁记录。
		</p>
		<p>
			门锁通过内置的通信模块接入云巴实时通信云服务，管理后台与手机客户端借助云巴的实时消息通道完成开锁指令下发、授权管理与开锁记录同步，实现远程多终端控制。
		</p>

		<h3>方案特点</h3>
		<ul style="padding-left:20px;">
			<li>蓝牙 + 云端双通道开锁，手机一键开门，密码可远程下发与删除</li>
			<li>多锁集中管理，一个 App 管理多把门锁，支持远程授权</li>
			<li>开锁记录实时上报，可在手机端随时查询</li>
			<li>基于云巴实时通信云服务，低延迟、高并发、稳定可靠</li>
		</ul>

		<p style="color:#999;font-size:13px;">（原页以整幅长图介绍方案细节，相关图片未留存于归档）</p>

		<div class="cta-row">
			<a href="/docs/" class="btn btn-outline">查看云巴文档</a>
			<a href="/usercases/parkinglock/" class="btn btn-primary">智能车位锁方案</a>
		</div>
	</div>
</SiteLayout>
