---
import SiteLayout from '../layouts/SiteLayout.astro';

type Release = { v: string; notes: string[] };
type Sdk = {
	key: string;
	name: string;
	icon: string;
	latest: string;
	download: string;
	doc: string;
	docLabel?: string;
	repo?: string;
	notes: string[];
	history: Release[];
};

const sdks: Sdk[] = [
	{
		key: 'android',
		name: 'Android',
		icon: 'android.png',
		latest: 'Android Release 1.8.6-beta',
		download: 'https://github.com/yunba/yunba-sdk-releases/raw/master/Android/YunBa-Android-sdk-1.8.6-beta.zip',
		doc: '/docs/android_sdk_api_manual/',
		notes: ['修复 Android 8 Crash 问题'],
		history: [
			{ v: 'Release 1.8.5', notes: [] },
			{ v: 'Release 1.8.4', notes: ['支持通配符'] },
			{ v: 'Release 1.8.0-beta', notes: ['支持华为等厂商推送'] },
			{ v: 'Release 1.6.4', notes: ['与 1.6.3 版本相同，增加了 so 文件。'] },
			{ v: 'Release 1.6.3', notes: ['后台进程相互拉起的特殊版本 SDK。'] },
			{ v: 'Release 1.4.5', notes: [] },
		],
	},
	{
		key: 'ios',
		name: 'iOS',
		icon: 'apple.png',
		latest: 'iOS Release 1.7.4',
		download: 'https://raw.githubusercontent.com/yunba/yunba-sdk-releases/master/iOS/YunBa-iOS-sdk-1.7.4.zip',
		doc: '/docs/ios_sdk_api_manual/',
		notes: ['支持通配符'],
		history: [
			{
				v: 'Release 1.7.3',
				notes: ['修复一个内存申请过多导致的问题', '修复demo中的显示错误', '修复网络状况较差时长时间 connnect 无返回的问题'],
			},
			{ v: 'Release 1.7.1', notes: ['解决 1.7.0 版本在飞行模式下的 assert crash bug'] },
			{
				v: 'Release 1.7.0',
				notes: ['优化 SDK 在 IPv6-only 网络下的链接状况', '针对新版本 iOS 做出链接优化', '增加 iOS 9.3 支持'],
			},
			{
				v: 'Release 1.6.4',
				notes: ['修复在网络状况反复失效时造成的 token 上传错误', '修复一个 demo 显示错位的问题', '修复预编译头文件编译告警'],
			},
			{ v: 'Release 1.6.3', notes: ['修复一个网络层的 bug', '修复 Xcode7 下的无效编译告警', '加快 SDK 链接速度'] },
			{
				v: 'Release 1.6.2',
				notes: ['增加 API timeout 和 heartbeat 的启动参数选项', '修复一个网络层的 bug', '增加 API 超时后的网络检查'],
			},
			{
				v: 'Release 1.6.0',
				notes: ['修改注册请求，适配 iOS9 ATS', '重构 demo', '在断链通知中增加链接断开原因', '增加 apns 界面及 apns 通知处理'],
			},
			{ v: 'Release 1.5.2', notes: ['允许 setAlias 参数为空（unset alias）', '增加 iOS 8.4 支持'] },
			{
				v: 'Release 1.5.1',
				notes: ['增加 GetStateV2/GetAliasListV2/GetTopicListV2 API', '增加带有 ttl 参数的 publish2 API', '增加 iOS8.3 支持'],
			},
		],
	},
	{
		key: 'js',
		name: 'JavaScript',
		icon: 'js.png',
		latest: 'JavaScript Release 2.1.2',
		download: 'https://github.com/yunba/yunba-javascript-sdk/archive/2.1.2.zip',
		doc: '/docs/js_sdk_api_manual/',
		repo: 'https://github.com/yunba/yunba-javascript-sdk',
		notes: ['修正 file 协议下默认 server', '关闭 Demo 时会取消订阅本次订阅的所有 Topic'],
		history: [
			{ v: 'Release 2.0.3', notes: ['修复了 get_alias_list、get_topic_list、get_state 接口批量操作时可能存在的 callback 回调问题'] },
			{ v: 'Release 2.0.2', notes: ['修正了例子中低版本 IE 浏览器判断注释的问题'] },
			{ v: 'Release 2.0.1', notes: ['没有功能上的更新，只是修正了例子中的 JS SDK 文件名'] },
			{ v: 'Release 2.0.1', notes: ['全新的 JS SDK 版本，更多的接口，强大的支持了 IE 7+ 浏览器'] },
		],
	},
	{
		key: 'java-socketio',
		name: 'Java Over Socket.IO',
		icon: 'java-socketio.png',
		latest: 'Java Over Socket.IO Release 1.0.0',
		download: 'https://github.com/yunba/yunba-socket.io-java-sdk/archive/master.zip',
		doc: '/docs/java_sdk_api_manual/',
		repo: 'https://github.com/yunba/yunba-socket.io-java-sdk',
		notes: ['初始版本, Java sdk 目前重构的第一版的 sdk 已经开发测试，欢迎在我们的 Github 上下载'],
		history: [],
	},
	{
		key: 'php',
		name: 'PHP',
		icon: 'php.png',
		latest: 'PHP Release 0.0.1',
		download: 'https://github.com/yunba/yunba-php-sdk/archive/master.zip',
		doc: '/docs/php_demo_quick_start/',
		repo: 'https://github.com/yunba/yunba-php-sdk',
		notes: ['demo 版本，仅提供订阅和发布消息功能，仅支持 Cli 模式下运行'],
		history: [],
	},
	{
		key: 'c',
		name: 'C',
		icon: 'c.png',
		latest: 'C Release 1.0.0',
		download: 'https://github.com/yunba/yunba-c-sdk/archive/master.zip',
		doc: '/docs/c_sdk_api_manual/',
		repo: 'https://github.com/yunba/yunba-c-sdk',
		notes: ['初始版本'],
		history: [],
	},
];
---

<SiteLayout title="SDK下载_云巴 Yunba - App、Web、物联网实时通讯云服务" active="downloads">
	<section class="page-hero tint">
		<div class="container">
			<h1>实时通信，尽在云巴</h1>
			<p>云巴 SDK 下载</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="sdk-nav">
				{sdks.map((s) => (
					<a href={`#${s.key}`}>
						<img src={`/site/static/img/sdks/${s.icon}`} alt={s.name} loading="lazy" />
						{s.name}
					</a>
				))}
			</div>

			{sdks.map((s) => (
				<div class="sdk-block" id={s.key}>
					<div class="sdk-block-head">
						<h3>{s.latest}</h3>
						<div class="sdk-actions">
							<a class="btn btn-primary" style="padding:6px 16px;font-size:13px;" href={s.download}
								>下载</a
							>
							<a href={s.doc}>查看文档</a>
							{s.repo && (
								<>
									<span style="color:#ddd;">|</span>
									<a href={s.repo} target="_blank" rel="noopener">完整代码</a>
								</>
							)}
						</div>
					</div>
					<div class="sdk-block-body">
						{s.notes.length > 0 && (
							<>
								<h4>版本说明</h4>
								<ul>
									{s.notes.map((n) => (
										<li>{n}</li>
									))}
								</ul>
							</>
						)}
						{s.history.length > 0 && (
							<>
								<h4>历史版本</h4>
								{s.history.map((h) => (
									<div class="release">
										<strong>{h.v}</strong>
										{h.notes.length > 0 && (
											<ul style="margin:6px 0 0;">
												{h.notes.map((n) => (
													<li>{n}</li>
												))}
											</ul>
										)}
									</div>
								))}
							</>
						)}
					</div>
				</div>
			))}

			<p style="color:#888;font-size:13px;margin-top:24px;">
				更多平台 SDK 与协议支持请见<a href="/docs/">文档中心</a>；Socket.IO 与 RESTful API 的使用方式参见 <a
					href="/docs/socketio_api_api_manual/">Socket.IO API 手册</a
				>、<a href="/docs/restful_api_api_manual/">RESTful API 手册</a>。
			</p>
		</div>
	</section>
</SiteLayout>
